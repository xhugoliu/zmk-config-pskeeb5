#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/mouse_setting.dtsi>
#include <dt-bindings/zmk/mouse_settings.h>

/ {
    mouse_ps2_input_listener {
        // keymap overlay 加载晚于 shield overlay，这里确保最终滚动层是第 2 层。
        scroll-layer = <2>;
    };
};

// 小红点灵敏度
#define U_MSS_TP_S_I &mms MS_TP_SENSITIVITY_INCR
#define U_MSS_TP_S_D &mms MS_TP_SENSITIVITY_DECR

// 默认层左旋钮：音量
#define BASE_LEFT_ENCODER &inc_dec_kp C_VOL_DN C_VOL_UP

// 鼠标层左旋钮：亮度
#define SYMBOL_LEFT_ENCODER &inc_dec_kp C_BRI_DN C_BRI_UP

// 默认层右旋钮：左右方向
#define BASE_RIGHT_ENCODER &inc_dec_kp LEFT RIGHT

// 导航层右旋钮：上下方向
#define NAV_RIGHT_ENCODER &inc_dec_kp DOWN UP

/ {
    behaviors {
        // 点按出键，长按出修饰键
        ht: hold_tap {
            display-name = "Hold Tap";
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // 点按出键，长按切层
        lt: layer_tap {
            display-name = "Layer Tap";
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // 编码器滚轮模板
        inc_dec_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    macros {
        ZMK_MACRO(type_abc111,
            bindings = <&kp A &kp B &kp C &kp N1 &kp N1 &kp N1>;
        )

        ZMK_MACRO(type_abc222,
            bindings = <&kp A &kp B &kp C &kp N2 &kp N2 &kp N2>;
        )

        ZMK_MACRO(type_abc333,
            bindings = <&kp A &kp B &kp C &kp N3 &kp N3 &kp N3>;
        )

        ZMK_MACRO(type_abc444,
            bindings = <&kp A &kp B &kp C &kp N4 &kp N4 &kp N4>;
        )

        ZMK_MACRO(type_abc555,
            bindings = <&kp A &kp B &kp C &kp N5 &kp N5 &kp N5>;
        )
    };

    combos {
        compatible = "zmk,combos";

        // W + S -> `
        combo_grave {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <1 11>;
            bindings = <&kp GRAVE>;
        };

        // E + D -> -
        combo_minus {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <2 12>;
            bindings = <&kp MINUS>;
        };

        // R + F -> =
        combo_equal {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <3 13>;
            bindings = <&kp EQUAL>;
        };

        // Y + H -> '
        combo_quote {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <5 15>;
            bindings = <&kp SQT>;
        };

        // U + J -> [
        combo_left_bracket {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <6 16>;
            bindings = <&kp LBKT>;
        };

        // I + K -> ]
        combo_right_bracket {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <7 17>;
            bindings = <&kp RBKT>;
        };

        // O + L -> backslash
        combo_backslash {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <8 18>;
            bindings = <&kp BSLH>;
        };

        // F + J -> F20
        combo_f20 {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <13 16>;
            bindings = <&kp F20>;
        };

        // D + K -> Ctrl + Space
        combo_ctrl_space {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <12 17>;
            bindings = <&kp LC(SPACE)>;
        };

        // S + L -> Gui + Space
        combo_gui_space {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <11 18>;
            bindings = <&kp LG(SPACE)>;
        };

    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // 2 + 3 -> 5
        device_layer {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y       &kp U        &kp I        &kp O       &kp P
                &kp A        &ht LGUI S   &ht LSHFT D  &ht LCTRL F  &ht LALT G   &ht LALT H  &ht LCTRL J  &ht LSHFT K  &ht LGUI L  &kp SEMI
                &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N       &kp M        &kp COMMA    &kp DOT     &kp FSLH
                             &kp C_MUTE   &lt 1 ESC    &lt 2 SPACE  &kp TAB      &mkp LCLK   &lt 3 ENTER  &lt 4 BSPC   &kp PSCRN
            >;
            sensor-bindings = <BASE_LEFT_ENCODER BASE_RIGHT_ENCODER>;
        };

        numpad_layer {
            bindings = <
                &none       &none     &none     &none      &none      &none         &kp N7      &kp N8      &kp N9      &kp N0
                &none       &kp LGUI  &kp LSHFT &kp LCTRL  &kp LALT   &kp KP_PLUS   &kp N4      &kp N5      &kp N6      &kp KP_MULTIPLY
                &none       &none     &none     &none      &none      &kp KP_MINUS  &kp N1      &kp N2      &kp N3      &kp KP_DIVIDE
                            &trans    &trans    &trans     &trans     &mkp MCLK     &kp N0      &kp KP_DOT  &trans
            >;
            sensor-bindings = <BASE_LEFT_ENCODER BASE_RIGHT_ENCODER>;
        };

        navigation_layer {
            bindings = <
                &none       &none     &none     &none      &none     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                &none       &kp LGUI  &kp LSHFT &kp LCTRL  &kp LALT  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
                &none       &none     &none     &none      &none     &none      &none      &none      &none      &none
                            &trans    &trans    &trans     &trans    &mkp RCLK  &trans     &kp DEL    &trans
            >;
            sensor-bindings = <BASE_LEFT_ENCODER NAV_RIGHT_ENCODER>;
        };

        mouse_layer {
            bindings = <
                &none       &mmv MOVE_LEFT &mmv MOVE_UP   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB1  &mkp MB2  &mkp MB3   &mkp MB4  &mkp MB5
                &none       &msc SCRL_LEFT &msc SCRL_UP   &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp LALT  &kp LCTRL &kp LSHFT  &kp LGUI  &none
                &none       &none          &none          &none           &none            &none     &none     &none      &none     &none
                            &trans         &trans         &trans          &trans           &trans    &trans    &trans     &trans
            >;
            sensor-bindings = <SYMBOL_LEFT_ENCODER BASE_RIGHT_ENCODER>;
        };

        function_layer {
            bindings = <
                &kp F1      &kp F2   &kp F3   &kp F4   &kp F5   &kp F16   &kp F17   &kp F18   &kp F19   &kp F20
                &kp F6      &kp F7   &kp F8   &kp F9   &kp F10  &kp LALT  &kp LCTRL &kp LSHFT &kp LGUI  &none
                &kp F11     &kp F12  &kp F13  &kp F14  &kp F15  &kp F21   &kp F22   &kp F23   &kp F24   &none
                            &trans   &trans   &trans   &trans   &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <BASE_LEFT_ENCODER BASE_RIGHT_ENCODER>;
        };

        device_layer {
            bindings = <
                &none        U_MSS_TP_S_D &bt BT_CLR   U_MSS_TP_S_I &none        &none        &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT   &none
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &type_abc111 &type_abc222   &type_abc333     &type_abc444 &type_abc555
                &none        &none        &none        &none        &none        &none        &none          &none            &none        &none
                             &trans       &trans       &trans       &trans       &trans       &trans         &trans           &trans
            >;
            sensor-bindings = <BASE_LEFT_ENCODER BASE_RIGHT_ENCODER>;
        };
    };
};
